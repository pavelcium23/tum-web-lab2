---
// Admin CMS Page
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Netlify CMS</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/netlify-cms@^2.0.0/dist/netlify-cms.min.js"></script>
  </head>
  <body>
    <script>
      if (window.netlifyIdentity) {
        window.netlifyIdentity.on('init', function(user) {
          if (!user) {
            window.netlifyIdentity.open();
          }
        });
      }
      window.CMS_MANUAL_INIT = true;
      CMS.init({
        config: {
          backend: {
            name: 'git-gateway',
            branch: 'main'
          },
          media_folder: 'public/images',
          public_folder: '/images',
          collections: [
            {
              name: 'home',
              label: 'Home Content',
              file: 'src/content/home/home.md',
              fields: [
                { name: 'title', label: 'Page Title', widget: 'string' },
                { name: 'hero_kicker', label: 'Hero Kicker', widget: 'string' },
                { name: 'hero_title', label: 'Hero Title', widget: 'string' },
                { name: 'hero_desc', label: 'Hero Description', widget: 'text' },
                { name: 'hero_cta', label: 'Hero CTA', widget: 'string' },
                { name: 'about_title', label: 'About Title', widget: 'string' },
                { name: 'about_desc', label: 'About Description', widget: 'text' },
                {
                  name: 'services',
                  label: 'Services',
                  widget: 'list',
                  fields: [
                    { name: 'title', label: 'Service Title', widget: 'string' },
                    { name: 'description', label: 'Service Description', widget: 'text' }
                  ]
                },
                {
                  name: 'portfolio',
                  label: 'Portfolio Items',
                  widget: 'list',
                  fields: [
                    { name: 'title', label: 'Item Title', widget: 'string' },
                    { name: 'type', label: 'Item Type', widget: 'string' },
                    { name: 'image', label: 'Image Path', widget: 'image' }
                  ]
                },
                { name: 'commission_title', label: 'Commission Title', widget: 'string' },
                { name: 'commission_desc', label: 'Commission Description', widget: 'text' },
                {
                  name: 'faq',
                  label: 'FAQ',
                  widget: 'list',
                  fields: [
                    { name: 'q', label: 'Question', widget: 'string' },
                    { name: 'a', label: 'Answer', widget: 'text' }
                  ]
                },
                { name: 'footer_text', label: 'Footer Text', widget: 'string' }
              ]
            }
          ]
        }
      });
    </script>
  </body>
</html>
